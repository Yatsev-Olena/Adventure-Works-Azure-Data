{
    "name": "ds_bronze_sink",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "linkedServiceName": {
            "referenceName": "ls_adls_bronze",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "p_sink_folder": {
                "type": "string"
            },
            "p_sink_file": {
                "type": "string"
            }
        },
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobStorageLocation",
                "container": "bronze",
                "folderPath": {
                    "value": "@dataset().p_sink_folder",
                    "type": "Expression"
                },
                "fileName": {
                    "value": "@dataset().p_sink_file",
                    "type": "Expression"
                }
            },
            "columnDelimiter": ",",
            "escapeChar": "\\",
            "quoteChar": "\"",
            "firstRowAsHeader": true
        },
        "schema": []
    }
}
